{
	"name": "nimbly/activeresource",
	"description": "Use a RESTful API in an ActiveRecord pattern.",
	"license": "MIT",
    "require": {
		"php": "^8.2",
		"psr/http-client": "^1.0",
		"psr/event-dispatcher": "^1.0",
		"nimbly/shuttle": "^2.0",
		"nimbly/capsule": "^3.0",
		"nimbly/announce": "^2.0"
	},
	"suggest": {
		"ext-curl": "Needed to use cURL based HTTP clients.",
		"ext-json": "Needed to encode and decode JSON request and responses."
	},
    "autoload": {
        "psr-4": {
            "Nimbly\\ActiveResource\\": "src/"
        }
    },
    "require-dev": {
		"symfony/var-dumper": "^5.0",
		"phpunit/phpunit": "^10.0",
		"vimeo/psalm": "^6.0"
	},
	"autoload-dev": {
		"psr-4": {
			"Nimbly\\ActiveResource\\Tests\\": "tests/"
		}
	}
}
